<?xml version="1.0" encoding="UTF-8"?>
<!-- ZONE-2 self-host: Next 운영 서버(pnpm start, :3002) 상시 구동. 크래시/재부팅 시 자동 재기동. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>kr.zone2.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/pnpm</string>
    <string>start</string>
  </array>
  <key>WorkingDirectory</key><string>__ZONE2_DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PORT</key><string>3002</string>
    <key>NODE_ENV</key><string>production</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/zone2-server.out</string>
  <key>StandardErrorPath</key><string>/tmp/zone2-server.err</string>
</dict>
</plist>
