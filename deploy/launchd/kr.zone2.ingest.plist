<?xml version="1.0" encoding="UTF-8"?>
<!-- ZONE-2 수집 크론 — 매시 정각. CRON_SECRET 을 채워라. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>kr.zone2.ingest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/curl</string>
    <string>-s</string><string>-X</string><string>POST</string>
    <string>http://localhost:3002/api/cron/ingest</string>
    <string>-H</string><string>Authorization: Bearer __CRON_SECRET__</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Minute</key><integer>0</integer></dict>
  <key>StandardErrorPath</key><string>/tmp/zone2-ingest.err</string>
</dict>
</plist>
