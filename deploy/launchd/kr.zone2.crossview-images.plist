<?xml version="1.0" encoding="UTF-8"?>
<!-- ZONE-2 크로스뷰 카드 이미지 자동 생성 — 매시 30분(ingest/매칭 후 신규 승인 페어 처리). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>kr.zone2.crossview-images</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/curl</string>
    <string>-s</string><string>-X</string><string>POST</string>
    <string>http://localhost:3002/api/cron/crossview-images</string>
    <string>-H</string><string>Authorization: Bearer __CRON_SECRET__</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Minute</key><integer>30</integer></dict>
  <key>StandardErrorPath</key><string>/tmp/zone2-crossview-images.err</string>
  <key>StandardOutPath</key><string>/tmp/zone2-crossview-images.out</string>
</dict>
</plist>
