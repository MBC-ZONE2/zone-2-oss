# ZONE-2 환경 변수 — 실제 값은 .env.local(Git 무시됨)에만 둔다. 변수 설명은 이 파일이 곧 문서다(README 「환경 변수」 표와 같이 간다).
# 운영(production) 필수 — 비면 해당 경로가 멈춘다: NEXT_PUBLIC_SUPABASE_URL · NEXT_PUBLIC_SUPABASE_ANON_KEY · SUPABASE_SERVICE_ROLE_KEY
#   · CRON_SECRET · INGEST_HASH_SALT · FORUM_HASH_PEPPER · VISIT_HASH_PEPPER. 나머지는 전부 선택(없으면 폴백·mock).

# --- 사이트 ---
# 공개 URL(메타·RSS·sitemap·OAuth 복귀). 비우면 config/region.ts 의 site.url
NEXT_PUBLIC_SITE_URL=

# --- Supabase ---
# 로컬은 `supabase start` 가 출력하는 API URL·anon key·service_role key 를 그대로.
# 운영에서 브라우저 OAuth(카카오)를 쓰면 localhost 가 아닌 공개 TLS Auth URL 이 필요하다(docs/deploy/kakao-admin-auth.md).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 서버 코드가 공개 URL 대신 쓸 내부 주소(선택, 예: http://127.0.0.1:54321 — 터널·프록시를 안 거친다)
SUPABASE_INTERNAL_URL=

# --- AI API 키(선택) — 하나도 없으면 결정적 mock 으로 돈다(화면·시드 확인에는 충분) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Gemini — 팟캐 음성(TTS)·크로스뷰 카드 이미지
GOOGLE_GENERATIVE_AI_API_KEY=
# 1 이면 키가 있어도 mock 응답 — 테스트·시연용
AI_MOCK=
# Cloudflare AI Gateway 를 거칠 때만(셋 다 있어야 켜진다)
AI_GATEWAY_ACCOUNT_ID=
AI_GATEWAY_ID=
AI_GATEWAY_TOKEN=

# --- AI (구독 CLI 경로 — API 키 대신) ---
# 운영 self-host 머신에 로그인된 구독 CLI 로 텍스트 생성을 돌린다.
# 켜면 재랭킹·요약·감정·대본이 이 경로를 먼저 타고, 실패 시 기존 로컬 폴백으로 내려간다.
# (임베딩=lib/ai/local-embed, TTS=lib/ai/local-tts 는 원래 키 없이 실동작)
# ⚠️ 크론·배치 전용이다 — CLI 1회 호출이 수 초라 사용자 동기 경로(공론장 moderate)엔 쓰지 않는다.
# ⚠️ 자식 프로세스를 띄우므로 self-host 에서만 동작한다(Cloudflare Workers 불가).
# 구독형 CLI 를 서버 크론 같은 자동화에 쓰는 것은 각 제공자(OpenAI·Anthropic) 약관 확인이 필요하다. 운영은 API 키 권장.
LOCAL_AI_CLI=
LOCAL_AI_CLI_BIN=
LOCAL_AI_CLI_EFFORT=
LOCAL_AI_CLI_TIMEOUT_MS=

# --- 감정분류 로컬 모델 (구독 CLI 보다 우선) ---
# 감정은 고빈도·좁은 분류라 LLM 보다 전용 모델이 낫다 — 수십 ms/건·무료·결정적(#85).
# 켜면 classifySentiment 가 로컬 모델 → 실패 시 구독 CLI → 실패 시 mock 순으로 내려간다.
# 사이드카: scripts/sentiment/classify_ko.py (Python + transformers 필요)
#   매핑 검사만: python3 scripts/sentiment/classify_ko.py --selftest
LOCAL_SENTIMENT=
LOCAL_SENTIMENT_PY=
LOCAL_SENTIMENT_MODEL=
LOCAL_SENTIMENT_BATCH=
LOCAL_SENTIMENT_TIMEOUT_MS=

# --- 데이터 소스 ---
# 유튜브: 둘 다 있어야 MbcYoutubeAdapter 가 수집한다(하나라도 없으면 수집 생략).
# 키는 Google Cloud Console 에서 발급하고 반드시 제한을 건다
#   — API 제한: YouTube Data API v3 / 애플리케이션 제한: 서버 IP.
# ⚠️ 키 값을 노션·카톡·이슈 등 공유 채널 본문에 붙여넣지 말 것.
YOUTUBE_API_KEY=
# MBC충북NEWS 채널 ID (공개 정보)
MBC_YOUTUBE_CHANNEL_ID=
# 유튜브 수집은 KST 0·6·12·18시에만 돈다(쿼터 보호).
# 수동 실행·검증에서 이 게이트를 열려면 1 로 둔다. 운영에서는 설정하지 말 것.
YOUTUBE_INGEST_FORCE=

# 데모 어댑터 — 창작 데모 기사/댓글을 실수집분과 같은 source 로 적재한다.
# 시연 지면을 채우려면 켜 두고(기본), 실운영에서는 반드시 0 으로 끈다.
#   0 = 실수집만 / 그 외(미설정 포함) = 데모 포함
DEMO_ADAPTERS=

# --- 운영 ---
CRON_SECRET=
# 비식별화 해시 키 — 운영(production) 필수. 미설정 시 해당 경로가 즉시 실패한다.
# 로컬 개발은 미설정 시 고정 폴백으로 동작(결정적 데모 보장).
INGEST_HASH_SALT=
FORUM_HASH_PEPPER=
# 1 이면 개발 빌드(next dev)에서 관리자 인증을 건너뛴다. 운영 빌드는 값과 무관하게 무시한다
PREVIEW_NO_AUTH=
# scripts/ops/create-admin-user.ts 가 --password 대신 읽는 초기 비밀번호(선택)
ADMIN_INITIAL_PASSWORD=
# 야간 백업 저장 위치(scripts/ops/backup-db.sh·관리자 「백업」). 기본 ~/zone2-backups
ZONE2_BACKUP_DIR=

# --- 임베드 위젯 (F8 · REQ-015) ---
# 양사 홈페이지 임베드 위젯이 읽는 공개 API(/api/crossview·/api/temperature)의 CORS 허용 오리진(콤마 구분 — 요청 Origin 과 일치하면 반사, middleware).
# 비우면: 운영(production) 빌드는 아무 오리진도 허용하지 않고(헤더 없음), 개발 빌드만 "*". 다른 사이트에 위젯을 심으려면 그 도메인을 적는다.
#   예: WIDGET_ALLOWED_ORIGIN=https://www.okinews.com,https://www.mbccb.co.kr
WIDGET_ALLOWED_ORIGIN=

# 팟캐 검수 마감 자동 공개: 회차 날짜 KST 이 시각(0~23)까지 반려가 없으면 사람 확인 없이 공개. 비우거나 off 면 꺼짐(기본·권장 — AI 생성물은 사람 확인 뒤에만 게시).
# off 면 검수자가 승인해야 공개되고, 정오 이후 매시 검수 대기 경고(podcast_pending_review)가 뜬다.
PODCAST_AUTO_PUBLISH_HOUR=

# --- 방문 기록 (#181 · 검증지표 ④ 재방문율·KPI 순방문자) ---
# 브라우저 무작위 ID 를 sha256(id + pepper) 로 바꿔 site_visits 에 하루 1행 남긴다(IP·UA 미저장).
# 운영 필수 — 없으면 기록을 멈추고 system_alerts(visit_pepper_missing) 에 남긴다.
# 생성 예: openssl rand -hex 32   (바꾸면 이전 방문자와 이어지지 않는다 — 한 번 정하면 유지)
VISIT_HASH_PEPPER=

# --- 팟캐 음성 ---
# gemini(기본, 아나운서 톤 — GOOGLE_GENERATIVE_AI_API_KEY 필요) · openai(gpt-4o-mini-tts) · 둘 다 안 되면 macOS `say` 폴백
TTS_PROVIDER=
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=
# macOS `say` 폴백의 목소리·속도(wpm, 기본 175)
LOCAL_TTS_VOICE=
LOCAL_TTS_RATE=

# ── 검색 노출(2026-10-26) — IndexNow(네이버·Bing). 32자 16진수(openssl rand -hex 16). 비우면 알림 안 함. /indexnow-key.txt 가 키 파일을 낸다 ──
INDEXNOW_KEY=

# ── 확인 규칙 — 필요한 확인 수는 코드 상수 REQUIRED_CONFIRMATIONS(lib/auth/roles): 공개 배포판 2(양측 확인), mbcok.com 운영 1(한쪽 확인 즉시 공개).
#    아래는 2 일 때만 뜻이 있는 절충: 한쪽 확인 후 N시간 지나면 상대 확인 없이 자동 공개. 비우거나 off 면 꺼짐(기본). 관리자 칩 표시용 NEXT_PUBLIC_ 도 같은 값 ──
CONFIRM_TIMEOUT_HOURS=
NEXT_PUBLIC_CONFIRM_TIMEOUT_HOURS=

# ── 범용 RSS 수집(#184, 다른 지역판의 기본 경로) — 광역·기초 매체의 RSS/Atom 주소. 여러 개면 쉼표. 비우면 어댑터가 올라가지 않는다 ──
RSS_MACRO_FEED_URL=
RSS_MICRO_FEED_URL=
